# Copy to .env and adjust. Every variable is optional.
MINILAB_DB=minilab.db
MINILAB_MODELS_DIR=models
MINILAB_INFERENCE_URL=http://127.0.0.1:8001
MINILAB_API_URL=http://127.0.0.1:8000
# URL shown to users in docs and snippets (defaults to MINILAB_API_URL)
MINILAB_PUBLIC_API_URL=http://127.0.0.1:8000
MINILAB_PLATFORM_URL=http://127.0.0.1:3000
# Shared secret between first-party services. Change it outside local development.
MINILAB_INTERNAL_TOKEN=dev-internal-token-change-me
MINILAB_DEFAULT_RPM=60
MINILAB_DEFAULT_TPM=40000
MINILAB_SIGNUP_CREDIT_USD=1.00
MINILAB_CREDIT_PACKS_USD=5,10,25
MINILAB_MAX_BATCH=8
# Stripe (test mode). Leave empty to use the built-in fake checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
